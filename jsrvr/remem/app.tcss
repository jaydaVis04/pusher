$scope-canvas: #0c111a;
$scope-panel: #121b27;
$scope-inset: #090f17;
$scope-edge: #273548;
$scope-ink: #dde7f0;
$scope-secondary: #a5b7c9;
$scope-muted: #72869a;
$scope-address: #73c9ec;
$scope-good: #8bcaa1;
$scope-warning: #e7bb73;
$scope-failure: #ef9292;
$scope-change: #d6a0e7;

Screen { background: $scope-canvas; color: $scope-ink; }
Header { background: $scope-panel; color: $scope-address; }
Footer { background: $scope-panel; }
#toolbar { height: 3; padding: 0 1; }
#devices { width: 1fr; min-width: 25; }
#toolbar Button { margin-left: 1; }
#connection { height: 2; padding: 0 2; color: $scope-secondary; }
TabbedContent { height: 1fr; }
Tabs { background: $scope-panel; }
TabPane { padding: 1 2; }
VerticalScroll { height: 1fr; }
.section-title { height: 2; padding-top: 1; color: $scope-address; text-style: bold; }
.hint { height: auto; color: $scope-muted; margin-bottom: 1; }
.instrument { background: $scope-panel; border: round $scope-edge; padding: 1 2; }
#summary { height: 9; }
#device-status { width: 1fr; margin-right: 1; }
#module-status { width: 1fr; }
.compact #summary { height: 18; layout: vertical; }
.compact #device-status, .compact #module-status { width: 100%; height: 9; margin: 0; }
.controls { height: 3; margin-bottom: 1; }
.controls > * { margin-right: 1; }
Input { background: $scope-inset; border: tall $scope-edge; width: 1fr; min-width: 10; }
Input:focus { border: tall $scope-address; }
Select { width: 1fr; }
SelectCurrent { background: $scope-inset; border: tall $scope-edge; }
Button { min-width: 10; background: $scope-panel; border: tall $scope-edge; }
Button:hover { background: $scope-edge; }
Button:focus { border: tall $scope-address; }
Button.-primary { background: #20445c; color: $scope-ink; }
Button.-error { background: #4b2a34; color: $scope-failure; }
.label-button { min-width: 8; width: 1fr; }
#known-table { height: 5; }
#region-table { height: 7; }
#watch-table, #hex-table { height: 1fr; min-height: 6; }
#snapshot-table { height: 16; }
#diff-table { height: 14; }
#neighborhood-table { height: 12; }
DataTable { background: $scope-inset; color: $scope-ink; }
DataTable > .datatable--header { background: $scope-panel; color: $scope-secondary; text-style: bold; }
DataTable > .datatable--cursor { background: #24394c; color: $scope-ink; }
DataTable > .datatable--hover { background: #1c2c3d; }
AddressMap { height: 9; margin-top: 1; min-width: 62; }
#command-log { height: 2fr; border: round $scope-edge; background: $scope-inset; }
#kernel-log { height: 1fr; border: round $scope-edge; background: $scope-inset; }
ModalScreen { align: center middle; background: $scope-canvas 80%; }
.dialog { width: 76; height: auto; max-height: 90%; background: $scope-panel;
    border: round $scope-edge; padding: 1 2; }
.dialog Static, .dialog Markdown { height: auto; margin-bottom: 1; }
.dialog .controls { margin-top: 1; }
