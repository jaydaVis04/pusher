from pathlib import Path
import hashlib

first = Path("current-6478f000.bin").read_bytes()
second = Path("second-6478f000.bin").read_bytes()
base = 0x6478f000
anchor_offset = 0x298
length = 16

if len(first) != len(second):
    raise SystemExit(
        f"Capture sizes differ: {len(first)} versus {len(second)}"
    )

differences = [
    i for i, (a, b) in enumerate(zip(first, second))
    if a != b
]

print("first sha256: ", hashlib.sha256(first).hexdigest())
print("second sha256:", hashlib.sha256(second).hexdigest())
print("changed bytes:", len(differences))
print(
    "first @0x298: ",
    first[anchor_offset:anchor_offset + length].hex()
)
print(
    "second @0x298:",
    second[anchor_offset:anchor_offset + length].hex()
)

if not differences:
    print("IDENTICAL: both 4096-byte captures are byte-for-byte equal")
else:
    print(f"first changed offset: 0x{differences[0]:x}")
    print(f"last changed offset:  0x{differences[-1]:x}")
    print("sample changed offsets (up to 32):")

    for offset in differences[:32]:
        print(
            f"0x{base + offset:x}: "
            f"{first[offset]:02x} -> {second[offset]:02x}"
        )
